# bmad-studio settings — copy to .env (gitignored) and fill in. No usernames/passwords here.

# veda root (BMAD {project-root}); must contain _bmad/
VEDA_ROOT=C:/Users/thedu/code/veda

# Random secret for signing bmad-studio sessions (>= 32 chars), e.g.
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
BMAD_STUDIO_SESSION_SECRET=

# Login uses the same credential as app-dashboard: path to its env file (read-only;
# only VEDA_DASHBOARD_USERNAME / VEDA_DASHBOARD_PASSWORD are read from it).
BMAD_STUDIO_CREDENTIALS_ENV_FILE=C:/Users/thedu/code/app-dashboard/.env.runtime

# Optional
# BMAD_STUDIO_ADMIN_ALLOWLIST=          # comma separated; empty = only VEDA_DASHBOARD_USERNAME is admin
# BMAD_STUDIO_TRUSTED_PROXIES=          # comma separated peer IPs allowed to set X-Forwarded-For
# BMAD_STUDIO_LOGIN_RATE_ATTEMPTS=5
# BMAD_STUDIO_LOGIN_RATE_WINDOW_SECONDS=900
# BMAD_STUDIO_COOKIE_SECURE=0           # 1 when served behind HTTPS
# BMAD_STUDIO_REVIEW_URL=https://bridgenbrain.duckdns.org/review
